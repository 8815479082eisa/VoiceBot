# Kopie als .env speichern und den eigenen Schlüssel eintragen.
# Die Datei .env wird nicht in Git aufgenommen.
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-6-luna
LLM_TIMEOUT_S=5
OPENAI_REASONING_EFFORT=none
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_REASONING=low
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
WISSEN_MIN_AEHNLICHKEIT=0.30
PROTOKOLL_AUFBEWAHRUNG_TAGE=30
GESPRAECHE_AUFBEWAHRUNG_TAGE=30

# Telefon: Diese Werte trägt die Konsole unter Einrichtung selbst ein.
OPENAI_PROJEKT_ID=
OPENAI_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TELEFON_OEFFENTLICHE_URL=
TELEFON_ZIELNUMMER=
TELEFON_LEITUNG_SID=
TELEFON_UEBERGABE_ZIEL=
TELEFON_MAX_ANRUFE=2
TELEFON_EIGENE_NUMMER=
TELEFON_UMLEITUNG_AKTIV=
